---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  index?: number;
}

const { project, index = 1 } = Astro.props;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const { title, description, category, technologies, accent, date } = project.data;
---

<article class="project-card" data-category={category}>
  <a class={`project-visual accent-${accent}`} href={`${base}projects/${project.id}/`} aria-label={`Lihat ${title}`}>
    <span class="project-number">{String(index).padStart(2, '0')}</span>
    <div class="visual-window" aria-hidden="true">
      <span></span><span></span><span></span>
      <div class="visual-content">
        <i></i><i></i><i></i>
      </div>
    </div>
    <span class="view-project">Lihat project <b>↗</b></span>
  </a>
  <div class="project-info">
    <div class="project-meta">
      <span>{category}</span>
      <time datetime={date.toISOString()}>{date.getFullYear()}</time>
    </div>
    <h3><a href={`${base}projects/${project.id}/`}>{title}</a></h3>
    <p>{description}</p>
    <ul class="tag-list" aria-label="Teknologi">
      {technologies.map((technology) => <li>{technology}</li>)}
    </ul>
  </div>
</article>
