---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PlatformIcon from '../components/PlatformIcon.astro';

const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const projects = (await getCollection('projects'))
  .filter(({ data }) => data.featured)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout>
  <section class="hero shell">
    <div class="hero-doodle hero-doodle-star" aria-hidden="true">✱</div>
    <div class="hero-doodle hero-doodle-arrow" aria-hidden="true">↝</div>
    <div class="hero-badge" aria-hidden="true"><span>Content</span><strong>with purpose</strong></div>
    <div class="hero-content">
      <div class="hero-copy">
        <div class="hero-eyebrow"><span></span> Social Media Officer · Content Creator</div>
        <h1>
          <em>Halo!</em><br />
          Saya<br />
          Galih.
        </h1>
        <div class="hero-bottom">
          <p>Saya bantu brand bikin konten yang menarik, rapi, dan punya tujuan.</p>
          <a class="circle-link" href="#projects" aria-label="Lihat karya pilihan">↓</a>
        </div>
        <div class="hero-skills" aria-label="Keahlian utama">
          <span>Social Media</span><span>Content Strategy</span><span>Copywriting</span><span>Video Editing</span><span>Meta Ads</span><span>Google Ads</span>
        </div>
        <div class="platform-list" aria-label="Platform yang dikuasai">
          <span><PlatformIcon name="instagram" />Instagram</span>
          <span><PlatformIcon name="tiktok" />TikTok</span>
          <span><PlatformIcon name="youtube" />YouTube</span>
          <span><PlatformIcon name="meta" />Meta Ads</span>
          <span><PlatformIcon name="google" />Google Ads</span>
        </div>
      </div>
      <figure class="hero-portrait">
        <div class="portrait-frame">
          <img src={`${base}images/galih-enggarnanto.webp`} alt="Galih Enggarnanto sedang berbicara menggunakan mikrofon" />
        </div>
        <figcaption><span>Konten adalah</span> kekuatan saya ⚡</figcaption>
      </figure>
    </div>
    <p class="hero-location"><span>◎</span> Depok, Jawa Barat · Bekerja secara digital</p>
  </section>

  <section class="service-invite">
    <div class="shell service-invite-inner">
      <div>
        <p class="kicker">Lagi mau tumbuhin brand?</p>
        <h2>Aku bisa bantu.</h2>
      </div>
      <div class="service-pills">
        <a href="#contact"><PlatformIcon name="meta" /><span><b>Meta Ads</b><small>Iklan Facebook & Instagram</small></span></a>
        <a href="#contact"><PlatformIcon name="google" /><span><b>Google Ads</b><small>Campaign berbasis pencarian</small></span></a>
        <a href="#contact"><span class="seo-icon">SEO</span><span><b>SEO Content Placement</b><small>Artikel dan publikasi digital</small></span></a>
      </div>
    </div>
  </section>

  <section class="marquee" aria-label="Keahlian utama">
    <div>
      <span>CONTENT STRATEGY</span><b>✦</b><span>STORYTELLING</span><b>✦</b><span>VIDEO PRODUCTION</span><b>✦</b><span>VISUAL DESIGN</span><b>✦</b>
      <span>CONTENT STRATEGY</span><b>✦</b><span>STORYTELLING</span><b>✦</b><span>VIDEO PRODUCTION</span><b>✦</b><span>VISUAL DESIGN</span><b>✦</b>
    </div>
  </section>

  <section class="impact-section shell" aria-labelledby="impact-title">
    <div class="impact-intro">
      <p class="kicker">Dampak konten di Latiseducation</p>
      <h2 id="impact-title">Angka yang<br /><em>bikin senang.</em></h2>
    </div>
    <div class="impact-grid">
      <article><strong>+250%</strong><span>Jangkauan Instagram</span></article>
      <article><strong>+140%</strong><span>Engagement Instagram</span></article>
      <article><strong>+1.300%</strong><span>Views TikTok</span></article>
      <article><strong>+2.430%</strong><span>Jangkauan TikTok</span></article>
    </div>
  </section>

  <section id="projects" class="project-showcase section">
    <div class="shell">
      <header class="section-heading">
        <div><span class="section-index">01</span><p>Project</p></div>
        <h2>My<em>Portofolio.</em></h2>
      </header>

      <div class="project-grid">
        {projects.map((project, index) => <ProjectCard project={project} index={index + 1} />)}
      </div>

      <div class="section-action">
        <a class="text-link" href={`${base}projects/`}>Lihat semua case study <span>↗</span></a>
      </div>
    </div>
  </section>

  <section class="experience-section">
    <div class="shell">
      <header class="section-heading">
        <div><span class="section-index">02</span><p>Pengalaman</p></div>
        <h2>Tempat aku<br /><em>pernah berkarya.</em></h2>
      </header>
      <div class="experience-list">
        <article>
          <time>08/2024 — Sekarang</time>
          <div><p>PT Latis Teknologi Indonesia</p><h3>Social Media Officer</h3></div>
          <p>Strategi konten, feeds, reels, dokumentasi, dan aset pemasaran digital.</p>
        </article>
        <article>
          <time>06/2024 — 07/2024</time>
          <div><p>Kubangan Kitchen</p><h3>Digital Marketing Intern</h3></div>
          <p>Strategi Instagram–TikTok dan produksi video dari ide sampai tayang.</p>
        </article>
        <article>
          <time>12/2023 — 12/2024</time>
          <div><p>UniPin</p><h3>Social Media Video Editor Intern</h3></div>
          <p>Video gaming untuk TikTok, Reels, dan Shorts.</p>
        </article>
        <article>
          <time>01/2022 — 03/2022</time>
          <div><p>Kemdikbudristek</p><h3>Humas & Publikasi Media Intern</h3></div>
          <p>Konten Instagram, berita, siaran pers, dan media monitoring.</p>
        </article>
      </div>
    </div>
  </section>

  <section id="about" class="about-section">
    <div class="shell about-grid">
      <div class="about-label"><span class="section-index">03</span><p>Tentang aku</p></div>
      <div class="about-copy">
        <p class="lead">Aku suka bikin <mark>konten yang jelas, menarik, dan berguna.</mark></p>
        <div class="about-columns">
          <p>Terbiasa mengembangkan ide, menyusun strategi, dan memproduksi konten untuk berbagai platform digital.</p>
          <p>Lulusan S1 Ilmu Komunikasi Universitas Gunadarma dengan IPK 3,65. Memiliki latar pendidikan Teknik Komputer dan Jaringan dari SMKN 1 Kusan Hilir, Kalimantan Selatan.</p>
        </div>
        <dl class="profile-facts">
          <div><dt>Domisili</dt><dd>Depok, Jawa Barat</dd></div>
          <div><dt>Tanggal lahir</dt><dd>13 Februari 2001</dd></div>
          <div><dt>Status</dt><dd>Belum menikah</dd></div>
          <div><dt>Pendidikan</dt><dd>S1 Ilmu Komunikasi</dd></div>
          <div><dt>Bahasa</dt><dd>Indonesia · English dasar</dd></div>
        </dl>
        <a class="cv-link" href={`${base}documents/galih-enggarnanto-cv.pdf`} target="_blank" rel="noreferrer">Unduh CV lengkap <span>↗</span></a>
        <div class="research-focus">
          <span>Fokus penelitian</span>
          <p>Pengaruh E-WOM, content marketing TikTok @skintific_id, dan brand awareness terhadap keputusan pembelian; serta terpaan konten YouTube Kobo Kanaeru terhadap pemenuhan kebutuhan informasi.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="services section">
    <div class="shell">
      <header class="section-heading compact">
        <div><span class="section-index">04</span><p>Layanan</p></div>
        <h2>Bisa bantu <em>apa?</em></h2>
      </header>
      <div class="service-list">
        <article><span aria-hidden="true">✦</span><h3>Content Strategy</h3><p>Ideasi, riset audiens, evaluasi performa, dan storytelling.</p><b>↗</b></article>
        <article><span aria-hidden="true">▶</span><h3>Video Production</h3><p>Riset, copywriting, videografi, dan editing short-form.</p><b>↗</b></article>
        <article><span aria-hidden="true">✎</span><h3>Visual Production</h3><p>Canva, Photoshop, Illustrator, serta desain digital dan cetak.</p><b>↗</b></article>
        <article><span aria-hidden="true">⌁</span><h3>Creative Tools</h3><p>Premiere Pro, CapCut, fotografi, dan Microsoft Office.</p><b>↗</b></article>
      </div>
      <div class="tool-list" aria-label="Perangkat dan tingkat keahlian">
        <span>Canva <b>Ahli</b></span>
        <span>Adobe Illustrator <b>Ahli</b></span>
        <span>Photoshop <b>Ahli</b></span>
        <span>CapCut <b>Ahli</b></span>
        <span>Premiere Pro <b>Menengah</b></span>
        <span>Desain digital & cetak <b>Mahir</b></span>
        <span>Fotografi <b>Menengah</b></span>
        <span>Videografi <b>Menengah</b></span>
        <span>Microsoft Office <b>Mahir</b></span>
      </div>
    </div>
  </section>

  <section id="contact" class="contact-section">
    <div class="shell contact-inner">
      <p>Punya project atau campaign?</p>
      <h2>Ngobrol<br /><em>yuk.</em></h2>
      <a class="contact-link" href="mailto:galihenggarnt@gmail.com">galihenggarnt@gmail.com <span>↗</span></a>
      <div class="contact-methods">
        <a href="tel:+6282149408905"><small>Telepon</small><span>0821 4940 8905</span></a>
        <a href="https://www.linkedin.com/in/galih-enggarnanto/" target="_blank" rel="noreferrer"><small>LinkedIn</small><span>galih-enggarnanto ↗</span></a>
        <a href="https://profile.mtalkblog.com" target="_blank" rel="noreferrer"><small>Website</small><span>profile.mtalkblog.com ↗</span></a>
      </div>
    </div>
  </section>
</BaseLayout>
