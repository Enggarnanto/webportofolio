---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';

const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const projects = (await getCollection('projects'))
  .filter(({ data }) => data.featured)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout>
  <section class="hero shell">
    <div class="hero-content">
      <div class="hero-copy">
        <div class="hero-eyebrow"><span></span> Social Media Officer · Content Creator</div>
        <h1>
          Ide yang kuat.<br />
          Konten yang<br />
          <em>bergerak.</em>
        </h1>
        <div class="hero-bottom">
          <p>Saya Galih Enggarnanto. Saya menggabungkan strategi, storytelling, dan kreativitas visual untuk menghasilkan konten yang relevan bagi audiens serta mendukung pertumbuhan brand.</p>
          <a class="circle-link" href="#projects" aria-label="Lihat karya pilihan">↓</a>
        </div>
      </div>
      <figure class="hero-portrait">
        <div class="portrait-frame">
          <img src={`${base}images/galih-enggarnanto.webp`} alt="Galih Enggarnanto sedang berbicara menggunakan mikrofon" />
        </div>
        <figcaption><span>Berbasis di</span> Depok, Jawa Barat</figcaption>
      </figure>
    </div>
  </section>

  <section class="marquee" aria-label="Keahlian utama">
    <div>
      <span>CONTENT STRATEGY</span><b>✦</b><span>STORYTELLING</span><b>✦</b><span>VIDEO PRODUCTION</span><b>✦</b><span>VISUAL DESIGN</span><b>✦</b>
      <span>CONTENT STRATEGY</span><b>✦</b><span>STORYTELLING</span><b>✦</b><span>VIDEO PRODUCTION</span><b>✦</b><span>VISUAL DESIGN</span><b>✦</b>
    </div>
  </section>

  <section class="impact-section shell" aria-labelledby="impact-title">
    <div class="impact-intro">
      <p class="kicker">Dampak konten di Latis</p>
      <h2 id="impact-title">Kreativitas yang<br /><em>terukur.</em></h2>
    </div>
    <div class="impact-grid">
      <article><strong>+250%</strong><span>Jangkauan Instagram</span></article>
      <article><strong>+140%</strong><span>Engagement Instagram</span></article>
      <article><strong>+1.300%</strong><span>Views TikTok</span></article>
      <article><strong>+2.430%</strong><span>Jangkauan TikTok</span></article>
    </div>
  </section>

  <section id="projects" class="section shell">
    <header class="section-heading">
      <div><span class="section-index">01</span><p>Karya & case study</p></div>
      <h2>Dari insight audiens<br />menjadi <em>konten.</em></h2>
    </header>

    <div class="project-grid">
      {projects.map((project, index) => <ProjectCard project={project} index={index + 1} />)}
    </div>

    <div class="section-action">
      <a class="text-link" href={`${base}projects/`}>Lihat semua case study <span>↗</span></a>
    </div>
  </section>

  <section class="experience-section">
    <div class="shell">
      <header class="section-heading">
        <div><span class="section-index">02</span><p>Pengalaman</p></div>
        <h2>Perjalanan mengolah<br /><em>cerita dan audiens.</em></h2>
      </header>
      <div class="experience-list">
        <article>
          <time>08/2024 — Sekarang</time>
          <div><p>PT Latis Teknologi Indonesia</p><h3>Social Media Officer</h3></div>
          <p>Mengembangkan strategi konten feeds dan reels, mendokumentasikan Supercamp, serta memproduksi aset visual untuk komunikasi dan pemasaran digital.</p>
        </article>
        <article>
          <time>06/2024 — 07/2024</time>
          <div><p>Kubangan Kitchen</p><h3>Digital Marketing Intern</h3></div>
          <p>Merancang strategi Instagram dan TikTok serta mengelola produksi video end-to-end hingga menjangkau 55.973 pengguna dan menghasilkan 50.941 penayangan.</p>
        </article>
        <article>
          <time>12/2023 — 12/2024</time>
          <div><p>UniPin</p><h3>Social Media Video Editor Intern</h3></div>
          <p>Memproduksi video pendek bertema gaming untuk TikTok, Reels, dan Shorts dari tahap riset, penulisan naskah, hingga penyuntingan.</p>
        </article>
        <article>
          <time>01/2022 — 03/2022</time>
          <div><p>Kemdikbudristek</p><h3>Humas & Publikasi Media Intern</h3></div>
          <p>Mengembangkan konten Instagram, menyusun draft berita dan siaran pers, serta memonitor pemberitaan menggunakan Brand24.</p>
        </article>
      </div>
    </div>
  </section>

  <section id="about" class="about-section">
    <div class="shell about-grid">
      <div class="about-label"><span class="section-index">03</span><p>Tentang saya</p></div>
      <div class="about-copy">
        <p class="lead">Konten yang baik lahir dari pertemuan antara <mark>data, cerita, dan visual</mark> yang memahami audiensnya.</p>
        <div class="about-columns">
          <p>Berpengalaman mengembangkan ide, menyusun strategi, dan memproduksi konten kreatif untuk berbagai platform digital. Data performa digunakan untuk mengevaluasi efektivitas konten dan menentukan pendekatan kreatif berikutnya.</p>
          <p>Lulusan S1 Ilmu Komunikasi Universitas Gunadarma dengan IPK 3,65. Memiliki latar pendidikan Teknik Komputer dan Jaringan dari SMKN 1 Kusan Hilir, Kalimantan Selatan.</p>
        </div>
        <dl class="profile-facts">
          <div><dt>Domisili</dt><dd>Depok, Jawa Barat</dd></div>
          <div><dt>Tanggal lahir</dt><dd>13 Februari 2001</dd></div>
          <div><dt>Status</dt><dd>Belum menikah</dd></div>
          <div><dt>Pendidikan</dt><dd>S1 Ilmu Komunikasi</dd></div>
          <div><dt>Bahasa</dt><dd>Indonesia · English dasar</dd></div>
        </dl>
        <a class="cv-link" href={`${base}documents/galih-enggarnanto-cv.pdf`} target="_blank" rel="noreferrer">Unduh CV lengkap <span>↗</span></a>
        <div class="research-focus">
          <span>Fokus penelitian</span>
          <p>Pengaruh E-WOM, content marketing TikTok @skintific_id, dan brand awareness terhadap keputusan pembelian; serta terpaan konten YouTube Kobo Kanaeru terhadap pemenuhan kebutuhan informasi.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="services section shell">
    <header class="section-heading compact">
      <div><span class="section-index">04</span><p>Keahlian</p></div>
      <h2>Strategi hingga<br /><em>eksekusi.</em></h2>
    </header>
    <div class="service-list">
      <article><span>01</span><h3>Content Strategy</h3><p>Ideasi, riset audiens, evaluasi performa, dan storytelling.</p><b>↗</b></article>
      <article><span>02</span><h3>Video Production</h3><p>Riset, copywriting, videografi, dan editing short-form.</p><b>↗</b></article>
      <article><span>03</span><h3>Visual Production</h3><p>Canva, Photoshop, Illustrator, serta desain digital dan cetak.</p><b>↗</b></article>
      <article><span>04</span><h3>Creative Tools</h3><p>Premiere Pro, CapCut, fotografi, dan Microsoft Office.</p><b>↗</b></article>
    </div>
    <div class="tool-list" aria-label="Perangkat dan tingkat keahlian">
      <span>Canva <b>Ahli</b></span>
      <span>Adobe Illustrator <b>Ahli</b></span>
      <span>Photoshop <b>Ahli</b></span>
      <span>CapCut <b>Ahli</b></span>
      <span>Premiere Pro <b>Menengah</b></span>
      <span>Desain digital & cetak <b>Mahir</b></span>
      <span>Fotografi <b>Menengah</b></span>
      <span>Videografi <b>Menengah</b></span>
      <span>Microsoft Office <b>Mahir</b></span>
    </div>
  </section>

  <section id="contact" class="contact-section">
    <div class="shell contact-inner">
      <p>Kolaborasi dan kesempatan baru</p>
      <h2>Mari membuat konten<br /><em>yang berarti.</em></h2>
      <a class="contact-link" href="mailto:galihenggarnt@gmail.com">galihenggarnt@gmail.com <span>↗</span></a>
      <div class="contact-methods">
        <a href="tel:+6282149408905"><small>Telepon</small><span>0821 4940 8905</span></a>
        <a href="https://www.linkedin.com/in/galih-enggarnanto/" target="_blank" rel="noreferrer"><small>LinkedIn</small><span>galih-enggarnanto ↗</span></a>
        <a href="https://profile.mtalkblog.com" target="_blank" rel="noreferrer"><small>Website</small><span>profile.mtalkblog.com ↗</span></a>
      </div>
    </div>
  </section>
</BaseLayout>
