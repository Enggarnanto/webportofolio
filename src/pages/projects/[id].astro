---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, description, category, technologies, status, role, date, accent, cover, gallery, videos, demo, github } = project.data;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const assetUrl = (path: string) => /^https?:\/\//.test(path) ? path : `${base}${path.replace(/^\//, '')}`;
const coverUrl = cover
  ? assetUrl(cover)
  : undefined;
---

<BaseLayout title={`${title} — Galih Enggarnanto`} description={description}>
  <article class="project-detail shell">
    <a class="back-link" href={`${base}projects/`}>← Kembali ke semua project</a>
    <header class="detail-header">
      <div>
        <p class="kicker">{category} / {date.getFullYear()}</p>
        <h1>{title}</h1>
        <p class="detail-intro">{description}</p>
      </div>
      <dl class="project-facts">
        <div><dt>Status</dt><dd>{status}</dd></div>
        <div><dt>Peran</dt><dd>{role}</dd></div>
        <div><dt>Keahlian</dt><dd>{technologies.join(', ')}</dd></div>
      </dl>
    </header>

    <div class={`detail-visual accent-${accent}`}>
      {coverUrl ? (
        <img class="detail-cover" src={coverUrl} alt={`Tampilan project ${title}`} />
      ) : (
        <div aria-hidden="true">
          <span class="detail-shape one"></span><span class="detail-shape two"></span>
          <div class="detail-browser"><i></i><i></i><i></i><b></b></div>
        </div>
      )}
    </div>

    <div class="detail-body">
      <aside class="detail-links">
        <span>Kontribusi</span>
        <p>{role}</p>
        {demo && <a href={demo} target="_blank" rel="noreferrer">Live demo ↗</a>}
        {github && <a href={github} target="_blank" rel="noreferrer">Source code ↗</a>}
      </aside>
      <div class="prose"><Content /></div>
    </div>

    {gallery.length > 0 && (
      <section class="project-gallery" aria-labelledby="gallery-title">
        <header>
          <p class="kicker">Dokumentasi karya</p>
          <h2 id="gallery-title">Proses dan hasil<br /><em>pilihan.</em></h2>
        </header>
        <div class="gallery-grid">
          {gallery.map((item, index) => (
            <figure class:list={{ wide: index % 5 === 0 }}>
              <img src={assetUrl(item.image)} alt={item.alt} loading="lazy" />
              {item.caption && <figcaption>{item.caption}</figcaption>}
            </figure>
          ))}
        </div>
      </section>
    )}

    {videos.length > 0 && (
      <section class="project-videos" aria-labelledby="video-title">
        <header>
          <p class="kicker">Showreel</p>
          <h2 id="video-title">Konten video<br /><em>terpilih.</em></h2>
        </header>
        <div class="video-grid">
          {videos.map((item) => (
            <figure>
              <video controls preload="metadata" playsinline poster={item.poster ? assetUrl(item.poster) : undefined}>
                <source src={assetUrl(item.video)} type="video/mp4" />
              </video>
              <figcaption>{item.title}</figcaption>
            </figure>
          ))}
        </div>
      </section>
    )}
  </article>
</BaseLayout>
