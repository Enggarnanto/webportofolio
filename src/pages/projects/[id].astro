---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, description, category, technologies, status, role, startDate, endDate, gallery, galleryFolder, galleryCount, galleryAlt, videos, ads, demo, github } = project.data;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const assetUrl = (path: string) => /^https?:\/\//.test(path) ? path : `${base}${path.replace(/^\//, '')}`;
const monthYear = new Intl.DateTimeFormat('id-ID', { month: 'long', year: 'numeric' });
const generatedGallery = galleryFolder
  ? Array.from({ length: galleryCount }, (_, index) => ({
      image: `${galleryFolder.replace(/\/$/, '')}/${String(index + 1).padStart(2, '0')}.webp`,
      alt: `${galleryAlt ?? `Dokumentasi karya ${title}`} ${index + 1}`,
      caption: undefined,
    }))
  : [];
const completeGallery = generatedGallery.length > 0 ? generatedGallery : gallery;
---

<BaseLayout title={`${title} — Galih Enggarnanto`} description={description}>
  <article class="project-detail shell">
    <a class="back-link" href={`${base}projects/`}>← Balik ke semua project</a>
    <div class="detail-layout">
      <div class="detail-copy">
        <header class="detail-header">
          <p class="kicker">{category} / {startDate.getFullYear()}</p>
          <h1>{title}</h1>
          <p class="detail-intro">{description}</p>
          <dl class="project-facts">
            <div><dt>Status</dt><dd>{status}</dd></div>
            <div><dt>Mulai</dt><dd>{monthYear.format(startDate)}</dd></div>
            <div><dt>Selesai</dt><dd>{endDate ? monthYear.format(endDate) : 'Sekarang'}</dd></div>
            <div><dt>Peran</dt><dd>{role}</dd></div>
            <div><dt>Keahlian</dt><dd>{technologies.join(', ')}</dd></div>
          </dl>
        </header>

        <div class="detail-body">
          <div class="prose"><Content /></div>
          <aside class="detail-links">
            <span>Kontribusi</span>
            <p>{role}</p>
            {demo && <a href={demo} target="_blank" rel="noreferrer">Live demo ↗</a>}
            {github && <a href={github} target="_blank" rel="noreferrer">Source code ↗</a>}
          </aside>
        </div>
      </div>

      <div class="detail-media">
        {completeGallery.length > 0 && (
          <details class="project-media-panel project-gallery">
            <summary>
              <span><small>Foto</small><strong>Dokumentasi fotonya.</strong></span>
              <b>{completeGallery.length} karya</b>
              <i aria-hidden="true">+</i>
            </summary>
            <div class="media-panel-content">
              <div class="gallery-grid">
                {completeGallery.map((item, index) => (
                  <figure class:list={{ wide: index % 5 === 0 }}>
                    <img src={assetUrl(item.image)} alt={item.alt} loading="lazy" />
                    {item.caption && <figcaption>{item.caption}</figcaption>}
                  </figure>
                ))}
              </div>
            </div>
          </details>
        )}

        {videos.length > 0 && (
          <details class="project-media-panel project-videos">
            <summary>
              <span><small>Video</small><strong>Tonton videonya.</strong></span>
              <b>{videos.length} video</b>
              <i aria-hidden="true">+</i>
            </summary>
            <div class="media-panel-content">
              <div class="video-grid">
                {videos.map((item) => (
                  <figure>
                    <video controls preload="none" playsinline poster={item.poster ? assetUrl(item.poster) : undefined}>
                      <source src={assetUrl(item.video)} type="video/mp4" />
                    </video>
                    <figcaption>{item.title}</figcaption>
                  </figure>
                ))}
              </div>
            </div>
          </details>
        )}

        {ads.length > 0 && (
          <details class="project-media-panel project-ads">
            <summary>
              <span><small>Iklan</small><strong>Materi iklannya.</strong></span>
              <b>{ads.length} materi</b>
              <i aria-hidden="true">+</i>
            </summary>
            <div class="media-panel-content">
              <div class="ads-grid">
                {ads.map((item) => (
                  <article class="ad-card">
                    {item.url ? (
                      <a class="ad-visual" href={item.url} target="_blank" rel="noreferrer">
                        <img src={assetUrl(item.image)} alt={item.alt} loading="lazy" />
                      </a>
                    ) : (
                      <div class="ad-visual">
                        <img src={assetUrl(item.image)} alt={item.alt} loading="lazy" />
                      </div>
                    )}
                    <div class="ad-copy">
                      {item.platform && <p>{item.platform}</p>}
                      <h3>{item.title}</h3>
                      {item.caption && <span>{item.caption}</span>}
                      {item.url && <a href={item.url} target="_blank" rel="noreferrer">Lihat iklan ↗</a>}
                    </div>
                  </article>
                ))}
              </div>
            </div>
          </details>
        )}
      </div>
    </div>
  </article>
</BaseLayout>
